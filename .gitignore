# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments (any depth)
**/venv/
**/venv_linux/
.venv/
env/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Uploaded media files
**/media/

# …but a vendored library's media/ is not an upload. Blockly fetches its
# toolbox icons and sounds from static/vendor/blockly/media/ at runtime, and
# the rule above swallowed all 19 of them: `git add -A` skipped them in
# silence, and CI caught a media path pointing at files that do not exist on
# the server — every icon a 404, which is worse than the CDN it replaced.
!cwa_classroom/static/vendor/**/media/
!cwa_classroom/static/vendor/**/media/**

# Database dumps
*.sql
sql/

# Environment variables
.env
.env.*

# Static files (collected)
staticfiles/
static_collected/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Misc
mysql.txt
venv-test/

# Claude Code worktrees (machine-local)
.claude/worktrees/

# Throwaway database built by scripts/demo_fill_blanks.sh
cwa_classroom/fill_blank_demo.sqlite3*

# Playwright screenshots written by the UI suite (design-review artefacts)
cwa_classroom/ui_tests/screenshots/*.png
